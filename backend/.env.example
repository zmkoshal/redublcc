# ====================================================================
# RED PUBLICIS - BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ====================================================================

# 1. SQLite (Default - Recommended for zero configuration)
DATABASE_URL=sqlite:///red_publicis.db

# 2. PostgreSQL Example (For enterprise multi-user deployment)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/red_publicis

# 3. MySQL / MariaDB Example
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/red_publicis

# Application Secret Key
SECRET_KEY=red-publicis-secret-key-2026-prod-secure-token

# Reporting & Financial Precision Defaults
DEFAULT_CURRENCY=PKR
DEFAULT_EXCHANGE_RATE=280.00
